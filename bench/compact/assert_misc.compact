// bench: the circuits of Compact's examples/assert/example_one.compact that Damp can express
// (ellen, myswitch, abel), with the ledger fields they use. Left out: the
// constructor and the circuits built from `[]`-valued expressions, nested lambdas and maps with
// `[]` keys/values (adam, bella, greg, fred, don, bob, maria, mandolin). Text is otherwise unchanged.
pragma language_version >= 0.15.0;

import CompactStandardLibrary;

export ledger round: Counter;
export ledger mapsy: Map<Field, Counter>;
export ledger kris: Map<Field, bobson>;
export ledger stan: Map<Field, bobson>;

struct bobson {
  a: Vector<1, Field>,
  b: Field,
  c: Boolean
}

export circuit ellen(x: bobson): [] {
  stan.insert(1 as Field, disclose(x));
  kris.insert(1 as Field, disclose(x));
  assert(kris.lookup(1 as Field).a[0] as Boolean == stan.lookup(1 as Field).a[0] as Boolean, "stan and kris");
}

export circuit myswitch(x: Field, y: Field, b: Boolean): Field {
  if(disclose(b)) {
    assert(x != y, "same");
    assert(round.increment(disclose(x) as Uint<16>) == round.increment(disclose(y) as Uint<16>), "counter");
    return x;
  } else {
    assert(y != x, "same");
    assert(round.increment(disclose(y) as Uint<16>) == round.increment(disclose(x) as Uint<16>), "counter");
    return y;
  }
}

export circuit abel(): [] {
  mapsy.insert(1 as Field, default<Counter>);

  assert(mapsy.lookup(1 as Field).read() != 2, "equal 1");
  assert(mapsy.lookup(1 as Field).increment(1) == [], "equal 2");
  assert((mapsy.lookup(1 as Field) += 2) == [], "equal 3");
}
