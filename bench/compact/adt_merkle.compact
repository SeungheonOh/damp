//PM-14807
// bench: Compact's examples/adt/tests/merkletree_field.compact and historicmerkletree_field.compact
// as one program (circuits `test` and `test_historic`). Changes: the two files' ledger fields are
// declared together, the historic file's `partialTree` renamed `historicPartialTree` and both files
// sharing one `path`; comments dropped.
import CompactStandardLibrary;

export ledger path: MerkleTreePath<4, Field>;

ledger merkleTree: MerkleTree<4, Field>;

ledger fakeRoot: MerkleTree<2, Field>;

ledger merkleTreeSmall: MerkleTree<2, Field>;

ledger partialTree: MerkleTree<4, Field>;

export ledger historicMerkleTree: HistoricMerkleTree<4, Field>;

export ledger historicMerkleTreeSmall: HistoricMerkleTree<2, Field>;

export ledger historicPartialTree: HistoricMerkleTree<4, Field>;

export circuit test(): [] {
  const digest = merkleTreePathRoot<4, Field>(path);
  assert(merkleTree.checkRoot(digest) == true, "valid root");
  assert(merkleTree.checkRoot(digest) == false, "invalid root");

  const hash = pad(32, "hash");
  merkleTree.insertHash(hash);

  const hashIndex = 2;
  merkleTree.insertHashIndex(hash, hashIndex);

  const index = 1;
  merkleTree.insertIndex(7 as Field, index);

  const defaultIndex = 3;
  merkleTree.insertIndexDefault(defaultIndex);

  for (const i of 0..4) {
    merkleTreeSmall.insert(i as Field);
  }
  assert(merkleTreeSmall.isFull() == true, "tree is full");

  assert(partialTree.isFull() == false, "tree is not full");

  partialTree.insert(42 as Field);
  partialTree.resetToDefault();
  assert(partialTree.isFull() == false, "tree is not full");

  partialTree.insert(100 as Field);

  return;
}

export circuit test_historic(): [] {
  const digest = merkleTreePathRoot<4, Field>(path);

  historicMerkleTree.insert(42 as Field);
  assert(historicMerkleTree.checkRoot(digest) == true, "");

  const digest2 = merkleTreePathRoot<4, Field>(path);

  assert(historicMerkleTree.checkRoot(digest2) == false, "");

  historicMerkleTree.insert(100 as Field);

  const hash = pad(32, "hash");
  historicMerkleTree.insertHash(hash);

  const hashIndex = 2;
  historicMerkleTree.insertHashIndex(hash, hashIndex);

  const index = 1;
  const value = 200 as Field;
  historicMerkleTree.insertIndex(value, index);

  const defaultIndex = 3;
  historicMerkleTree.insertIndexDefault(defaultIndex);

  for (const i of 0..4) {
    historicMerkleTreeSmall.insert(i as Field);
  }
  assert(historicMerkleTreeSmall.isFull() == true, "");

  assert(historicPartialTree.isFull() == false, "");

  historicMerkleTree.resetHistory();

  historicMerkleTree.resetToDefault();
  assert(historicMerkleTree.isFull() == false, "");

  historicMerkleTree.insert(500 as Field);
}
