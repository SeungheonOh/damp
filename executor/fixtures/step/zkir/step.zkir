{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%a.0", "type": "Scalar<BLS12-381>" },
    { "name": "%b.1", "type": "Scalar<BLS12-381>" },
    { "name": "%n.2", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_to_boolean", "val": "%b.1" },
    { "op": "constrain_bits", "val": "%n.2", "bits": 16 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%t.3", "guard": "%b.1" },
    { "op": "less_than", "output": "%tmp.4", "a": "%t.3", "b": "0x0a", "bits": 4 },
    { "op": "assert", "cond": "%tmp.4" },
    { "op": "cond_select", "output": "%h.5", "bit": "%b.1", "a": "%t.3", "b": "0x00" },
    { "op": "mul", "output": "%t.6", "a": "%a.0", "b": "%a.0" },
    { "op": "add", "output": "%t.7", "a": "%t.6", "b": "%h.5" },
    { "op": "transient_hash", "output": "%t.8", "inputs": ["%a.0"] },
    { "op": "neg", "output": "%neg.9", "a": "%t.8" },
    { "op": "add", "output": "%r.10", "a": "%t.7", "b": "%neg.9" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "-0x02", "%r.10"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "less_than", "output": "%t.11", "a": "%n.2", "b": "0xe803", "bits": 16 },
    { "op": "assert", "cond": "%t.11" },
    { "op": "output", "vals": ["%r.10"] }
  ]
}
