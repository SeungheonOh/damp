{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%x.0", "type": "Scalar<BLS12-381>" },
    { "name": "%b.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%x.0", "bits": 8 },
    { "op": "constrain_to_boolean", "val": "%b.1" },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%s.2", "guard": null },
    { "op": "persistent_hash", "output": "%bytes.3", "alignment": [{ "tag": "atom", "value": { "tag": "field" } }], "inputs": ["%s.2"] },
    { "op": "bytes_into_natives", "outputs": ["%t.4", "%t.5"], "bytes": "%bytes.3" },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.6", "guard": null },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.7", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x20", "%t.6", "%t.7"] },
    { "op": "test_eq", "output": "%t.8", "a": "%t.5", "b": "%t.6" },
    { "op": "test_eq", "output": "%t.9", "a": "%t.4", "b": "%t.7" },
    { "op": "cond_select", "output": "%t.10", "bit": "%t.8", "a": "%t.9", "b": "0x00" },
    { "op": "assert", "cond": "%t.10" },
    { "op": "impact", "guard": "%b.1", "inputs": ["0x70", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "%b.1", "inputs": ["0x0e", "%x.0"] },
    { "op": "impact", "guard": "%b.1", "inputs": ["0xa1"] }
  ]
}
